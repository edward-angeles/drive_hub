@model List<DriveHub.Models.Order>
@using DriveHub.Models
@using System.Globalization

@{
    ViewData["Title"] = "Order History";

    var orders = Model ?? new List<Order>();

    var cad = CultureInfo.GetCultureInfo("en-CA");
}

<div class="container py-4">

    <!-- Page heading -->
    <div class="mb-4">
        <h1 class="fw-bold mb-2">Order History</h1>

        <p class="text-muted">
            View your previous purchases and check
            the payment status of your orders.
        </p>
    </div>

    <!-- Orders panel -->
    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between
                        align-items-center mb-3">

                <h5 class="fw-bold mb-0">
                    My Orders
                </h5>

                <span class="badge bg-light text-dark border">
                    @orders.Count orders
                </span>

            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            @if (orders.Count == 0)
            {
                <!-- Empty order history -->
                <div class="text-center py-5">

                    <h4 class="fw-bold">
                        No orders yet
                    </h4>

                    <p class="text-muted mb-4">
                        Your purchases will appear here
                        after you complete checkout.
                    </p>

                    <a asp-controller="Parts"
                       asp-action="Index"
                       class="btn text-white"
                       style="background-color: #087f73;">
                        Browse Parts
                    </a>

                </div>
            }
            else
            {
                <!-- Order history table -->
                <div class="table-responsive">

                    <table class="table table-hover
                                  align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Order</th>
                                <th>Date</th>
                                <th>Total</th>
                                <th>Payment</th>
                                <th class="text-end">
                                    Action
                                </th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var order in orders)
                            {
                                var status = order.PaymentStatus;

                                string badgeClass = status switch
                                {
                                    PaymentStatus.Paid =>
                                        "bg-success",

                                    PaymentStatus.Pending =>
                                        "bg-warning text-dark",

                                    PaymentStatus.Failed =>
                                        "bg-danger",

                                    PaymentStatus.Cancelled =>
                                        "bg-secondary",

                                    PaymentStatus.Refunded =>
                                        "bg-info text-dark",

                                    _ => "bg-secondary"
                                };

                                <tr>

                                    <!-- Order number -->
                                    <td class="fw-semibold">
                                        @order.OrderNumber
                                    </td>

                                    <!-- Order date -->
                                    <td>
                                        @order.CreatedAt.ToString(
                                            "MMM dd, yyyy")
                                    </td>

                                    <!-- Total -->
                                    <td class="fw-semibold">
                                        @((order.MerchandiseTotalCents
                                            / 100m).ToString("C", cad))
                                    </td>

                                    <!-- Payment status -->
                                    <td>
                                        <span class="badge @badgeClass">
                                            @status
                                        </span>
                                    </td>

                                    <!-- Details -->
                                    <td class="text-end">

                                        <a asp-controller="Orders"
                                           asp-action="Details"
                                           asp-route-id="@order.Id"
                                           class="btn btn-sm btn-outline-secondary">

                                            View Details

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

    <!-- Back to marketplace -->
    <div class="mt-4">

        <a asp-controller="Parts"
           asp-action="Index"
           class="text-decoration-none"
           style="color: #087f73;">

            &larr; Back to Marketplace

        </a>

    </div>

</div>
