@model CarPart
<div asp-validation-summary="All" class="error"></div><div class="formgrid"><label>Name<input asp-for="Name"/></label><label>Manufacturer<input asp-for="Manufacturer"/></label><label>Part number<input asp-for="PartNumber"/></label><label>Category<select asp-for="Category" asp-items="Html.GetEnumSelectList<PartType>()"></select></label><label>Condition<select asp-for="Condition" asp-items="Html.GetEnumSelectList<PartCondition>()"></select></label><label>Car-Part grade<select asp-for="Grade" asp-items="Html.GetEnumSelectList<CarPartGrade>()"></select></label><label>Quality score (0–100)<input asp-for="QualityScore" type="number"/></label><label>Price (CAD)<input asp-for="Price" type="number" step="0.01"/></label><label>Quantity<input asp-for="Quantity" type="number"/></label><label>Warranty (months)<input asp-for="WarrantyMonths" type="number"/></label><label>Mileage (km, optional)<input asp-for="MileageKm" type="number"/></label><label>Description<textarea asp-for="Description"></textarea></label></div><button type="submit">Save part</button> <a asp-action="Manage">Cancel</a>
