@model List<CarPart>
<h1>Seller inventory (demo)</h1><p>This is an unsecured development-only screen. Authentication and role restrictions are next.</p><p><a class="button" asp-action="Create">+ Add part</a></p><div class="tablewrap"><table><thead><tr><th>Part</th><th>Category</th><th>Price</th><th>Stock</th><th>Actions</th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Name</td><td>@p.Category</td><td>@p.Price.ToString("C")</td><td>@p.Quantity</td><td><a asp-action="Edit" asp-route-id="@p.Id">Edit</a> · <a asp-action="Delete" asp-route-id="@p.Id">Delete</a></td></tr>}</tbody></table></div>
