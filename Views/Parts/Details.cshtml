@model CarPart
<p><a asp-action="Index">← Back to marketplace</a></p><div class="card detail"><span class="eyebrow">@Model.Category • @Model.Condition</span><h1>@Model.Name</h1><h2>@Model.Price.ToString("C")</h2><p><strong>Manufacturer:</strong> @Model.Manufacturer</p><p><strong>Part number:</strong> @Model.PartNumber</p><p><strong>Car-Part grade:</strong> @Model.Grade (seller-entered)</p><p><strong>Quality:</strong> @Model.QualityScore/100</p><p><strong>Warranty:</strong> @Model.WarrantyMonths months</p><p><strong>Quantity:</strong> @Model.Quantity</p><p>@Model.Description</p><p><em>Vehicle fitment is not yet verified. Checkout will be added in a later milestone.</em></p></div>
